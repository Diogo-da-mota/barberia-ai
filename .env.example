# Barberia AI — variáveis de ambiente (exemplo)
# Copie para .env e preencha com valores reais. Não commite o .env.

# Supabase (projeto autorizado: hbkbdqctelembzqiptpi)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_publica

# Google OAuth (configurar no Supabase Auth e no Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com

# App
VITE_APP_URL=http://localhost:5173

# Google Calendar por profissional (F10): só "true" depois de implantar google-calendar-oauth e outbox-worker
VITE_GOOGLE_CALENDAR_ENABLED=false

# SEGREDOS DE SERVIDOR (NUNCA no navegador, nunca com prefixo VITE_): configurar só com `supabase secrets set`
#   WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN, WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WORKER_SECRET,
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, APP_URL
